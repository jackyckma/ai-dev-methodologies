# Cloud agent bootstrap — environment variable names only
# Copy names into your Cloud Agent UI. Never commit secret values.

# --- AI providers (Minimax default) ---
MINIMAX_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Common Cloud UI aliases (promoted by setup-cloud-agent-env.sh):
# minimax_api_key, MMINIMAX_API_KEY → MINIMAX_API_KEY
# openrouter_api_key, openrouter_api → OPENROUTER_API_KEY

# --- GitHub ---
GH_TOKEN=
GITHUB_TOKEN=

# --- Optional: Cloudflare (DNS/email) ---
CLOUDFLARE_API_TOKEN=

# --- Optional: project-specific ---
# STAGING_URL=https://your-app.zeabur.app
# AGENT_VERIFY_SKIP_L2=1

# Bootstrap script path (run in Cloud Agent setup):
# bash scripts/setup-cloud-agent-env.sh
